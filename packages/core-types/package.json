{
  "name": "@clearrun/core-types",
  "version": "0.1.0",
  "description": "ClearRun shared verdict contract — TypeScript mirror of schema/verdict.schema.json. The only type surface shared between the open integration packages and the closed kernel.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build_package.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "clearrun",
    "verdict",
    "contract",
    "types"
  ],
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
