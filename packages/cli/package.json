{
  "name": "@clearrun/cli",
  "version": "0.2.0",
  "description": "ClearRun CLI. Score AI answers for honesty (confidence vs reasoning) through the hosted API. Not a fact-checker.",
  "license": "MIT",
  "author": "Adepoco <contact@adepoco.com>",
  "homepage": "https://clearrun.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adepoco/ClearRun.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Adepoco/ClearRun/issues"
  },
  "keywords": [
    "clearrun",
    "cli",
    "honesty",
    "calibration"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "clearrun": "./dist/index.js"
  },
  "scripts": {
    "build": "node ../../scripts/build_package.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clearrun/sdk": "^0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
