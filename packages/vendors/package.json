{
  "name": "@clearrun/vendors",
  "version": "0.1.0",
  "description": "Vendor/provider adapter metadata for the ClearRun open client.",
  "license": "MIT",
  "homepage": "https://clearrun.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adepoco/ClearRun.git",
    "directory": "packages/vendors"
  },
  "bugs": {
    "url": "https://github.com/Adepoco/ClearRun/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build_package.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.17.0",
    "@google/generative-ai": "^0.2.1",
    "openai": "^4.28.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
