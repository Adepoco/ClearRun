{
  "name": "@clearrun/sdk",
  "version": "0.2.0",
  "description": "Scores AI answers for honesty (confidence-justification alignment). Not a fact-checker.",
  "license": "MIT",
  "author": "Adepoco <contact@adepoco.com>",
  "homepage": "https://clearrun.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adepoco/ClearRun.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Adepoco/ClearRun/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build_package.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["clearrun", "sdk", "honesty", "verdict", "client"],
  "dependencies": {
    "@clearrun/core-types": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
