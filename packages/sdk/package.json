{
  "name": "@clearrun/sdk",
  "version": "0.1.0",
  "description": "ClearRun public SDK — HostedApiClient + MockKernelClient implementing the HonestyKernelClient boundary. Depends only on @clearrun/core-types; runs standalone against the mock with the closed kernel absent.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["clearrun", "sdk", "honesty", "verdict", "client"],
  "dependencies": {
    "@clearrun/core-types": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
